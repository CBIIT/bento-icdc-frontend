  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "start": "node scripts/start.js",
    "build_": "node scripts/build.js",
    "test": "jest",
    "lint": "npx eslint src",
    "format": "npx prettier --write src/",
    "dev": "npm i --legacy-peer-deps && NODE_ENV=development webpack-dev-server --config ./webpack/dev.js",
    "build": "NODE_ENV=production webpack --config ./webpack/prod.js",
    "serve": "http-server dist",
    "prepare": "husky",
    "generate": "graphql-codegen"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "npx eslint src",
      "prettier --write --ignore-unknown"
    ]
  },
  "jest": {
    "collectCoverage": true,
    "moduleNameMapper": {
      "^.+.(svg)$": "jest-svg-transformer"
    },
    "testMatch": [
      "**/__test__/**.test.js"
    ]
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  }
