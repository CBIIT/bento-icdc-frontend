  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "start": "node scripts/start.js",
    "build_": "node scripts/build.js",
    "test": "jest --coverage --watch=false",
    "lint": "npx eslint src",
    "format": "npx prettier --write src/",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "dev": "npm i --legacy-peer-deps && NODE_ENV=development webpack-dev-server --config ./webpack/dev.js",
    "build": "NODE_ENV=production webpack --config ./webpack/prod.js",
    "serve": "http-server dist",
    "prepare": "husky",
    "generate": "graphql-codegen"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "npx eslint src",
      "prettier --write --ignore-unknown"
    ]
  },
  "jest": {
    "collectCoverage": true,
    "testEnvironment": "jsdom",
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "testMatch": [
      "**/__test__/**/*.test.[jt]s?(x)"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest",
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "moduleNameMapper": {
      "^.+\\.(svg|png|jpe?g|gif|webp|avif)$": "<rootDir>/__mocks__/fileMock.js"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.tsx"
    ]
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39"
